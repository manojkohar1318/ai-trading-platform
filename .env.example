# Market data provider
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=

# Dhan market-data configuration (never commit real credentials)
DHAN_ACCESS_TOKEN=
DHAN_CLIENT_ID=
DHAN_INSTRUMENT_MASTER_PATH=data/dhan-instruments.csv
