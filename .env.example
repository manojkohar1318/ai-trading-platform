# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# API
ENVIRONMENT=development
API_CORS_ORIGINS=http://localhost:3000

# Database (server-side only)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading_ai

